---
import { ticker } from '../data/profile';
const dots = ['var(--coral)', 'var(--orange)', 'var(--yellow)', 'var(--teal)'];
---

<div class="marquee span-8 reveal" style="--d:.15s" aria-hidden="true">
  <div class="track">
    {[0, 1].map(() => (
      <div class="set">
        {ticker.map((t, i) => (
          <>
            <span>{t}</span>
            <em style={`color:${dots[i % 4]}`}>∞</em>
          </>
        ))}
      </div>
    ))}
  </div>
</div>

<style>
  .marquee {
    grid-column: span 12;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .track {
    display: flex;
    width: max-content;
    animation: slide 32s linear infinite;
  }
  .marquee:hover .track {
    animation-play-state: paused;
  }
  .set {
    display: flex;
    align-items: center;
    gap: 22px;
    padding-right: 22px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    color: var(--text);
    white-space: nowrap;
  }
  em {
    font-style: normal;
    font-size: 1.3em;
  }
  @keyframes slide {
    to {
      transform: translateX(-50%);
    }
  }
  @media (min-width: 900px) {
    .marquee {
      grid-column: span 8;
    }
  }
</style>
