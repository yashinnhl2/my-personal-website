---
import Icon from './Icon.astro';
import { profile } from '../data/profile';

interface Props {
  /** Set on non-home pages to highlight that page's link instead of scroll-spying. */
  current?: 'blog';
}
const { current } = Astro.props;

const links = [
  { href: '/#home', label: 'Home' },
  { href: '/#about', label: 'About' },
  { href: '/#work', label: 'Work' },
  { href: '/#contact', label: 'Contact' },
  { href: '/blog', label: 'Blog', page: 'blog' },
];
---

<header class="bar">
  <a href="/#home" class="logo" aria-label={`${profile.shortName} — home`}>
    {profile.shortName.toUpperCase()}<span>.</span>
  </a>

  <nav class="pill" aria-label="Primary" data-current={current}>
    <span class="glider" aria-hidden="true"></span>
    {links.map((l) => (
      <a href={l.href} data-link data-page={l.page} aria-current={l.page && l.page === current ? 'page' : undefined}>
        {l.label}
      </a>
    ))}
  </nav>

  <div class="socials">
    <button type="button" data-open-contact aria-label="Contact me"><Icon name="mail" /></button>
    <a href={profile.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
      <Icon name="linkedin" />
    </a>
  </div>
</header>

<style>
  .bar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px clamp(16px, 4vw, 48px);
    animation: drop 0.9s var(--ease) both;
  }

  .logo {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.35rem;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .logo span {
    color: var(--coral);
    display: inline-block;
    transition: transform 0.4s var(--ease);
  }
  .logo:hover span {
    transform: translateY(-4px) scale(1.4);
  }

  .pill {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    display: flex;
    padding: 5px;
    border-radius: 999px;
    background: rgba(32, 34, 36, 0.72);
    border: 1px solid var(--line);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }
  .pill a {
    position: relative;
    z-index: 1;
    padding: 9px 18px;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--muted);
    border-radius: 999px;
    transition: color 0.25s;
  }
  .pill a:hover,
  .pill a.active {
    color: var(--text);
  }
  .glider {
    position: absolute;
    top: 5px;
    bottom: 5px;
    left: 0;
    width: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.09);
    transition:
      transform 0.45s var(--ease),
      width 0.45s var(--ease);
  }

  .socials {
    display: flex;
    gap: 6px;
  }
  .socials a,
  .socials button {
    padding: 0;
    font: inherit;
    border: 0;
    background: none;
    cursor: pointer;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    color: var(--muted);
    transition:
      color 0.25s,
      background 0.25s,
      transform 0.4s var(--ease);
  }
  .socials a:hover,
  .socials button:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-3px);
  }

  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-24px);
    }
  }

  @media (max-width: 720px) {
    .bar {
      flex-wrap: wrap;
      gap: 10px;
      justify-content: space-between;
    }
    .pill {
      position: static;
      translate: none;
      order: 3;
      width: 100%;
      justify-content: space-between;
    }
    .pill a {
      padding: 9px 9px;
    }
  }
</style>

<script>
  const pill = document.querySelector('.pill') as HTMLElement;
  const glider = pill.querySelector('.glider') as HTMLElement;
  const links = [...pill.querySelectorAll<HTMLAnchorElement>('[data-link]')];

  function moveTo(a: HTMLAnchorElement) {
    links.forEach((l) => l.classList.toggle('active', l === a));
    glider.style.width = `${a.offsetWidth}px`;
    glider.style.transform = `translateX(${a.offsetLeft}px)`;
  }

  // On the home page, scroll-spy the sections; on other pages, highlight that page's link.
  const page = pill.dataset.current;
  let current = (page && links.find((l) => l.dataset.page === page)) || links[0];

  if (!page) {
    const sections = links
      .filter((l) => l.hash)
      .map((l) => document.querySelector(l.hash) as HTMLElement | null)
      .filter((s): s is HTMLElement => !!s);

    const spy = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            current = links.find((l) => l.hash === `#${e.target.id}`) ?? current;
            moveTo(current);
          }
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => spy.observe(s));
  }

  moveTo(current);
  addEventListener('resize', () => moveTo(current));
  document.fonts?.ready.then(() => moveTo(current));
</script>
