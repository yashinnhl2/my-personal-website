---
import Icon from './Icon.astro';
import { formatDate, readingTime, type Post } from '../utils/blog';

interface Props {
  post: Post;
  delay?: number;
}
const { post, delay = 0 } = Astro.props;
const { title, description, date, tags } = post.data;
const dots = ['var(--coral)', 'var(--orange)', 'var(--yellow)', 'var(--teal)'];
---

<a class="card post reveal" href={`/blog/${post.id}`} style={`--d:${delay}s`}>
  <p class="meta">
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
    <span>{readingTime(post)} min read</span>
  </p>
  <h2>{title}</h2>
  <p class="desc">{description}</p>
  {tags.length > 0 && (
    <ul>{tags.map((t, i) => <li style={`--c:${dots[i % 4]}`}><i></i>{t}</li>)}</ul>
  )}
  <span class="go"><Icon name="arrow" size={18} /></span>
</a>

<style>
  .post {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-right: 84px;
  }
  .meta {
    display: flex;
    gap: 14px;
    align-items: baseline;
    font-size: 0.85rem;
  }
  .meta time {
    font-family: var(--font-dot);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--yellow);
  }
  h2 {
    font-size: clamp(1.35rem, 2.6vw, 1.8rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    transition: color 0.3s;
  }
  .post:hover h2 {
    color: var(--orange);
  }
  .desc {
    max-width: 62ch;
  }
  ul {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 3px 12px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text);
    background: #1d1d21;
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  li i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c);
  }
  .go {
    position: absolute;
    top: 50%;
    right: 26px;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: var(--text);
    background: #26262a;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 6px 16px rgba(0, 0, 0, 0.4);
    transition:
      background 0.3s,
      color 0.3s,
      transform 0.4s var(--ease);
  }
  .post:hover .go {
    background: var(--coral);
    color: #111;
    transform: rotate(45deg);
  }
  @media (max-width: 560px) {
    .post {
      padding-right: clamp(22px, 3vw, 34px);
      padding-bottom: 76px;
    }
    .go {
      top: auto;
      bottom: 18px;
      translate: none;
    }
  }
</style>
