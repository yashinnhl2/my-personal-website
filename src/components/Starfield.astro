<canvas id="stars" aria-hidden="true"></canvas>

<style>
  canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
</style>

<script>
  const canvas = document.getElementById('stars') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const tints = ['#ffffff', '#ffffff', '#ffffff', '#f4a261', '#e9c46a', '#2a9d8f'];

  type Star = { x: number; y: number; r: number; depth: number; phase: number; speed: number; c: string };
  type Shooter = { x: number; y: number; vx: number; vy: number; life: number };

  let stars: Star[] = [];
  let shooters: Shooter[] = [];
  let w = 0;
  let h = 0;
  let scrollY = 0;
  let mx = 0;
  let my = 0;

  function resize() {
    const dpr = Math.min(devicePixelRatio || 1, 2);
    w = innerWidth;
    h = innerHeight;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const count = Math.round((w * h) / 9000);
    stars = Array.from({ length: count }, () => {
      const depth = Math.random();
      return {
        x: Math.random() * w,
        y: Math.random() * h,
        r: 0.4 + depth * 1.2,
        depth,
        phase: Math.random() * Math.PI * 2,
        speed: 0.4 + Math.random() * 1.4,
        c: tints[Math.floor(Math.random() * tints.length)],
      };
    });
  }

  function draw(t: number) {
    ctx.clearRect(0, 0, w, h);
    for (const s of stars) {
      const tw = reduced ? 0.7 : 0.35 + 0.65 * (0.5 + 0.5 * Math.sin(t / 1000 * s.speed + s.phase));
      // parallax: closer stars drift more on scroll / pointer
      let y = (s.y - scrollY * s.depth * 0.25) % h;
      if (y < 0) y += h;
      const x = s.x + mx * s.depth * 14;
      ctx.globalAlpha = tw * (0.35 + s.depth * 0.65);
      ctx.fillStyle = s.c;
      ctx.beginPath();
      ctx.arc(x, y + my * s.depth * 14, s.r, 0, Math.PI * 2);
      ctx.fill();
    }

    for (const m of shooters) {
      m.x += m.vx;
      m.y += m.vy;
      m.life -= 0.016;
      const g = ctx.createLinearGradient(m.x, m.y, m.x - m.vx * 14, m.y - m.vy * 14);
      g.addColorStop(0, `rgba(255,255,255,${Math.max(m.life, 0)})`);
      g.addColorStop(1, 'rgba(255,255,255,0)');
      ctx.globalAlpha = 1;
      ctx.strokeStyle = g;
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(m.x, m.y);
      ctx.lineTo(m.x - m.vx * 14, m.y - m.vy * 14);
      ctx.stroke();
    }
    shooters = shooters.filter((m) => m.life > 0);

    if (!reduced && Math.random() < 0.0022) {
      shooters.push({ x: Math.random() * w * 0.8, y: Math.random() * h * 0.4, vx: 7, vy: 3.5, life: 1 });
    }
    requestAnimationFrame(draw);
  }

  resize();
  addEventListener('resize', resize);
  addEventListener('scroll', () => (scrollY = window.scrollY), { passive: true });
  addEventListener('pointermove', (e) => {
    mx = e.clientX / w - 0.5;
    my = e.clientY / h - 0.5;
  });
  requestAnimationFrame(draw);
</script>
