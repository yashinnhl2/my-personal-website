---
import { skillGroups } from '../data/profile';

let n = 0; // running index so chips stagger across the whole card
---

<section class="card skills reveal" style="--d:.05s">
  <h2 class="card-title">What I work with</h2>
  <p class="card-sub">The tools I reach for, grouped by where they sit in the stack.</p>

  <div class="groups">
    {skillGroups.map((g) => (
      <div class="group" style={`--c:${g.color}`}>
        <h3>{g.title}<small>{g.note}</small></h3>
        <ul>
          {g.items.map((item) => (
            <li style={`--i:${n++}`}>{item}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .groups {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px 28px;
    margin-top: 30px;
  }
  @media (min-width: 600px) {
    .groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1000px) {
    .groups {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .group {
    padding-top: 16px;
    border-top: 2px solid var(--c);
  }
  h3 {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 1.15rem;
    font-weight: 600;
  }
  h3 small {
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--muted);
  }

  ul {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  li {
    padding: 7px 14px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text);
    background: #1d1d21;
    border: 1px solid var(--line);
    border-radius: 999px;
    transition:
      opacity 0.6s var(--ease) calc(0.2s + var(--i) * 0.035s),
      transform 0.6s var(--ease) calc(0.2s + var(--i) * 0.035s),
      border-color 0.3s,
      background 0.3s;
  }
  /* staggered pop-in once the card scrolls into view */
  :global(.js .reveal:not(.in)) li {
    opacity: 0;
    transform: translateY(12px) scale(0.92);
  }
  li:hover {
    transform: translateY(-3px) rotate(-1.5deg);
    border-color: var(--c);
    background: color-mix(in srgb, var(--c) 14%, #1d1d21);
    transition-delay: 0s;
  }
</style>
