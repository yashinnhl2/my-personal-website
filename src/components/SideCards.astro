---
import Icon from './Icon.astro';
import { experience } from '../data/profile';

const byId = (id: string) => experience.find((e) => e.id === id)!;

const cards = [
  { tag: 'Now', accent: 'var(--teal)', items: [byId('upgrade')] },
  { tag: 'Previously', accent: 'var(--orange)', items: [byId('veem'), byId('cisco')] },
];
---

{cards.map(({ tag, accent, items }, i) => (
  <section class="card side span-4 reveal" style={`--accent:${accent};--d:${0.1 + i * 0.12}s`}>
    <span class="eyebrow"><i></i>{tag}</span>
    <ul>
      {items.map((e) => (
        <li>
          <a href="#work" data-goto={e.id}>
            <span class="text">
              <h2 class="name">{e.company}</h2>
              <p>{e.role}<br />{e.period}</p>
            </span>
            <span class="go"><Icon name="arrow" size={16} /></span>
          </a>
        </li>
      ))}
    </ul>
  </section>
))}

<style>
  .side {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .eyebrow i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li + li {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px dashed rgba(255, 255, 255, 0.12);
  }
  a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .name {
    font-size: clamp(1.4rem, 2.3vw, 1.85rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    transition: color 0.3s;
  }
  a:hover .name {
    color: var(--accent);
  }
  p {
    margin-top: 4px;
    font-size: 0.88rem;
    line-height: 1.45;
  }
  .go {
    flex: none;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    color: var(--text);
    background: #26262a;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 6px 16px rgba(0, 0, 0, 0.4);
    transition:
      background 0.3s,
      color 0.3s,
      transform 0.4s var(--ease);
  }
  a:hover .go {
    background: var(--accent);
    color: #111;
    transform: rotate(45deg);
  }
  .side::after {
    content: '';
    position: absolute;
    right: -40px;
    bottom: -40px;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--accent), transparent 68%);
    opacity: 0.16;
    transition:
      opacity 0.4s,
      transform 0.6s var(--ease);
    z-index: -1;
  }
  .side:hover::after {
    opacity: 0.4;
    transform: scale(1.4);
  }
</style>

<script>
  // jump to a company in the experience tabs
  document.querySelectorAll<HTMLElement>('[data-goto]').forEach((el) => {
    el.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('select-company', { detail: el.dataset.goto }));
    });
  });
</script>
