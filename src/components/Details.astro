---
import { languages, certifications, profile } from '../data/profile';
---

<section class="card span-4 md-half reveal">
  <h2 class="card-title">Languages</h2>
  <ul class="langs">
    {languages.map((l) => (
      <li style={`--p:${l.pct}%`}>
        <div><b>{l.name}</b><span>{l.level}</span></div>
        <div class="meter"><span></span></div>
      </li>
    ))}
  </ul>
</section>

<section class="card span-4 md-half reveal" style="--d:.1s">
  <h2 class="card-title">Certified</h2>
  <ul class="certs">
    {certifications.map((c) => (
      <li><i></i>{c}</li>
    ))}
  </ul>
</section>

<section class="card span-4 loc reveal" style="--d:.2s">
  <span class="eyebrow">Based in</span>
  <h2 class="card-title">{profile.location}</h2>
  <p class="clock"><span id="clock">--:--</span><small>local time</small></p>
</section>

<style>
  ul {
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .langs li > div:first-child {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.9rem;
  }
  b {
    color: var(--text);
    font-weight: 600;
  }
  .meter {
    margin-top: 8px;
    height: 6px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.07);
    overflow: hidden;
  }
  .meter span {
    display: block;
    height: 100%;
    width: var(--p);
    border-radius: 6px;
    background: linear-gradient(90deg, var(--teal), var(--yellow));
    transform-origin: left;
    transition: transform 1.2s var(--ease) 0.4s;
  }
  :global(.js .reveal:not(.in)) .meter span {
    transform: scaleX(0);
  }
  .certs li {
    position: relative;
    padding-left: 22px;
    color: var(--text);
    font-size: 0.95rem;
    line-height: 1.4;
  }
  .certs i {
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--orange);
    rotate: 45deg;
  }
  .loc {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .clock {
    margin-top: auto;
    padding-top: 16px;
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .clock span {
    font-family: var(--font-dot);
    font-weight: 700;
    font-size: 2.6rem;
    line-height: 1;
    color: var(--yellow);
  }
</style>

<script define:vars={{ tz: profile.timeZone }}>
  const el = document.getElementById('clock');
  const fmt = new Intl.DateTimeFormat('en-CA', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: tz });
  const tick = () => {
    if (el) el.textContent = fmt.format(new Date());
  };
  tick();
  setInterval(tick, 15000);
</script>
