---
import Icon from './Icon.astro';
import { getPosts, formatDate, readingTime } from '../utils/blog';

const posts = (await getPosts()).slice(0, 3);
---

{posts.length > 0 && (
  <section id="writing" class="card writing reveal">
    <div class="top">
      <div>
        <h2 class="card-title">Latest writing</h2>
        <p class="card-sub">Notes on frontend, HCI and things I build.</p>
      </div>
      <a class="all" href="/blog">All posts <Icon name="arrow" size={16} /></a>
    </div>

    <ul>
      {posts.map((p) => (
        <li>
          <a href={`/blog/${p.id}`}>
            <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
            <span class="title">{p.data.title}</span>
            <span class="rt">{readingTime(p)} min</span>
            <Icon name="arrow" size={18} />
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    flex-wrap: wrap;
  }
  .all {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text);
    background: #1d1d21;
    border: 1px solid var(--line);
    border-radius: var(--radius-btn);
    transition:
      background 0.3s,
      color 0.3s;
  }
  .all:hover {
    background: var(--orange);
    color: #17110e;
  }
  ul {
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
  }
  li + li {
    border-top: 1px dashed rgba(255, 255, 255, 0.12);
  }
  li a {
    display: grid;
    grid-template-columns: 130px 1fr auto 22px;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
    transition:
      padding 0.4s var(--ease),
      color 0.3s;
  }
  li a:hover {
    padding-left: 10px;
    color: var(--text);
  }
  time {
    white-space: nowrap;
    font-family: var(--font-dot);
    font-weight: 700;
    font-size: 1rem;
    color: var(--yellow);
  }
  .title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.12rem;
    color: var(--text);
  }
  .rt {
    font-size: 0.85rem;
  }
  li a :global(svg) {
    transition:
      transform 0.4s var(--ease),
      color 0.3s;
  }
  li a:hover :global(svg) {
    color: var(--coral);
    transform: rotate(45deg);
  }
  @media (max-width: 640px) {
    li a {
      grid-template-columns: 1fr 22px;
    }
    time,
    .rt {
      grid-column: 1;
    }
    .title {
      grid-column: 1;
      grid-row: 2;
    }
    li a :global(svg) {
      grid-column: 2;
      grid-row: 1 / span 3;
    }
  }
</style>
