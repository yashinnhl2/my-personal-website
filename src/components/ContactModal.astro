---
import Icon from './Icon.astro';
import { profile } from '../data/profile';
---

<dialog id="contact-modal" aria-labelledby="cm-title" data-email={profile.email} data-state="idle">
  <div class="panel">
    <div class="glow" aria-hidden="true">
      <div class="blob b1"></div>
      <div class="blob b2"></div>
    </div>

    <button type="button" class="close" data-close aria-label="Close">
      <Icon name="close" size={18} />
    </button>

    <div class="form-view">
      <span class="eyebrow">Contact</span>
      <h2 id="cm-title">Say hello<i>.</i></h2>
      <p class="lead">Tell me what you’re working on. I’ll get back to you.</p>

      <form novalidate>
        <div class="field">
          <label for="cm-name">Name</label>
          <input id="cm-name" name="name" type="text" autofocus autocomplete="name" placeholder="Your name" required maxlength="100" />
          <small class="err" data-for="name"></small>
        </div>

        <div class="field">
          <label for="cm-email">Email</label>
          <input id="cm-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required maxlength="200" />
          <small class="err" data-for="email"></small>
        </div>

        <div class="field">
          <label for="cm-message">Message</label>
          <textarea id="cm-message" name="message" rows="5" placeholder="What’s on your mind?" required minlength="10" maxlength="3000"></textarea>
          <small class="err" data-for="message"></small>
        </div>

        <!-- honeypot: real people never see or fill this -->
        <div class="hp" aria-hidden="true">
          <label>Website <input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
        </div>

        <p class="fail" role="alert">
          Something went wrong sending that. Please try again in a moment, or reach out on
          <a href={profile.linkedin} target="_blank" rel="noopener">LinkedIn</a>.
        </p>

        <button type="submit" class="submit">
          <span class="label">Send message <Icon name="send" size={18} /></span>
          <span class="spinner" aria-hidden="true"></span>
        </button>
      </form>
    </div>

    <div class="done-view" aria-live="polite">
      <span class="tick">
        <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m5 12.500 4.500 4.500L19 7.500"></path>
        </svg>
      </span>
      <h2>Thanks<i data-name></i>!</h2>
      <p class="lead" data-done-text>Your message is on its way.</p>
      <button type="button" class="submit ghost" data-close>Close</button>
    </div>
  </div>
</dialog>

<style>
  dialog {
    width: min(540px, calc(100vw - 32px));
    max-height: calc(100dvh - 32px);
    margin: auto;
    padding: 0;
    color: var(--muted);
    background: transparent;
    border: 0;
    overflow: visible;
  }
  dialog::backdrop {
    background: rgba(8, 10, 10, 0.68);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  dialog[open] {
    animation: pop-in 0.5s var(--ease);
  }
  dialog[open]::backdrop {
    animation: fade 0.4s ease;
  }
  dialog[data-closing] {
    animation: pop-out 0.28s ease forwards;
  }
  dialog[data-closing]::backdrop {
    animation: fade 0.28s ease reverse forwards;
  }

  .panel {
    position: relative;
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    padding: clamp(24px, 5vw, 40px);
    background: var(--card);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 26px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
    isolation: isolate;
  }

  /* clipped wrapper so the blurred blobs never add scrollable overflow */
  .glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
  }
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.2;
    pointer-events: none;
  }
  .b1 {
    width: 240px;
    height: 240px;
    top: -90px;
    right: -60px;
    background: var(--coral);
  }
  .b2 {
    width: 200px;
    height: 200px;
    bottom: -90px;
    left: -60px;
    background: var(--teal);
  }

  .close {
    position: absolute;
    top: 16px;
    right: 16px;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    padding: 0;
    color: var(--muted);
    background: #212125;
    border: 1px solid var(--line);
    border-radius: 50%;
    cursor: pointer;
    transition:
      color 0.25s,
      background 0.25s,
      transform 0.4s var(--ease);
  }
  .close:hover {
    color: var(--text);
    background: #2c2c31;
    transform: rotate(90deg);
  }

  h2 {
    margin-top: 8px;
    font-size: clamp(1.9rem, 5vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  h2 i {
    font-style: normal;
    color: var(--coral);
  }
  .lead {
    margin-top: 6px;
    font-size: 0.98rem;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 24px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  label {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8b8b8b;
  }
  input,
  textarea {
    width: 100%;
    padding: 13px 16px;
    font: inherit;
    font-size: 1rem;
    color: var(--text);
    background: #1b1b1f;
    border: 1px solid var(--line);
    border-radius: 14px;
    transition:
      border-color 0.25s,
      box-shadow 0.25s,
      background 0.25s;
  }
  textarea {
    min-height: 130px;
    resize: vertical;
  }
  input::placeholder,
  textarea::placeholder {
    color: #5f5f66;
  }
  input:hover,
  textarea:hover {
    border-color: rgba(255, 255, 255, 0.18);
  }
  input:focus,
  textarea:focus {
    outline: none;
    background: #202025;
    border-color: var(--orange);
    box-shadow: 0 0 0 4px rgba(244, 162, 97, 0.16);
  }
  .field.invalid input,
  .field.invalid textarea {
    border-color: var(--coral);
    box-shadow: 0 0 0 4px rgba(231, 133, 97, 0.14);
  }
  .err {
    min-height: 0;
    font-size: 0.82rem;
    color: var(--coral);
  }
  .field.invalid .err {
    animation: nudge 0.35s var(--ease);
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .fail {
    display: none;
    padding: 12px 16px;
    font-size: 0.9rem;
    color: var(--text);
    background: rgba(231, 133, 97, 0.12);
    border: 1px solid rgba(231, 133, 97, 0.4);
    border-radius: 12px;
  }
  .fail a {
    color: var(--orange);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  dialog[data-state='error'] .fail {
    display: block;
  }

  .submit {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    min-width: 172px;
    padding: 14px 26px;
    font: inherit;
    font-weight: 600;
    font-size: 0.95rem;
    color: #17110e;
    background: var(--coral);
    border: 0;
    border-radius: var(--radius-btn);
    cursor: pointer;
    transition:
      background 0.3s,
      transform 0.25s var(--ease),
      opacity 0.25s;
  }
  .submit:hover {
    background: var(--yellow);
  }
  .submit:active {
    transform: scale(0.97);
  }
  .submit .label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .submit .label :global(svg) {
    transition: transform 0.4s var(--ease);
  }
  .submit:hover .label :global(svg) {
    transform: translate(3px, -3px);
  }
  .submit.ghost {
    color: var(--text);
    background: #2a2a2e;
  }
  .submit.ghost:hover {
    background: var(--orange);
    color: #17110e;
  }

  .spinner {
    position: absolute;
    width: 20px;
    height: 20px;
    border: 2.5px solid rgba(23, 17, 14, 0.25);
    border-top-color: #17110e;
    border-radius: 50%;
    opacity: 0;
    animation: spin 0.7s linear infinite;
  }
  dialog[data-state='sending'] .submit {
    pointer-events: none;
  }
  dialog[data-state='sending'] .label {
    opacity: 0;
  }
  dialog[data-state='sending'] .spinner {
    opacity: 1;
  }

  /* success view */
  .done-view {
    display: none;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: 12px 0 4px;
  }
  .done-view .submit {
    margin-top: 18px;
  }
  dialog[data-state='sent'] .form-view {
    display: none;
  }
  dialog[data-state='sent'] .done-view {
    display: flex;
    animation: fade 0.5s ease;
  }
  .tick {
    display: grid;
    place-items: center;
    width: 68px;
    height: 68px;
    margin-bottom: 14px;
    color: #0f1d1b;
    background: var(--teal);
    border-radius: 50%;
    animation: pop 0.6s var(--ease);
  }
  .tick path {
    stroke-dasharray: 26;
    stroke-dashoffset: 26;
    animation: draw 0.5s ease 0.3s forwards;
  }

  @keyframes pop-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.94);
    }
  }
  @keyframes pop-out {
    to {
      opacity: 0;
      transform: translateY(16px) scale(0.96);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  @keyframes pop {
    from {
      transform: scale(0);
    }
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes nudge {
    from {
      opacity: 0;
      transform: translateX(-8px);
    }
  }
</style>

<script>
  const dialog = document.getElementById('contact-modal') as HTMLDialogElement;
  const form = dialog.querySelector('form') as HTMLFormElement;
  const doneText = dialog.querySelector('[data-done-text]') as HTMLElement;
  const nameSlot = dialog.querySelector('[data-name]') as HTMLElement;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Optional: a form-backend URL (Formspree, Web3Forms, ...) that accepts a JSON POST.
  // Without one, submitting opens the visitor's email app with the message prefilled.
  const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT as string | undefined;
  const toEmail = dialog.dataset.email!;

  const setState = (s: 'idle' | 'sending' | 'sent' | 'error') => (dialog.dataset.state = s);

  function openModal() {
    setState('idle');
    delete dialog.dataset.closing;
    document.documentElement.classList.add('modal-open');
    dialog.showModal();
  }

  function closeModal() {
    if (!dialog.open || 'closing' in dialog.dataset) return;
    if (reduced) return dialog.close();
    dialog.dataset.closing = '';
    dialog.addEventListener('animationend', () => dialog.close(), { once: true });
  }

  document.querySelectorAll<HTMLElement>('[data-open-contact]').forEach((el) =>
    el.addEventListener('click', (e) => {
      e.preventDefault();
      openModal();
    }),
  );

  dialog.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', closeModal));
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) closeModal(); // click on the backdrop
  });
  // Esc: run the closing animation first. Handled on keydown too, since
  // not every browser/input path fires `cancel` for it.
  dialog.addEventListener('cancel', (e) => {
    e.preventDefault();
    closeModal();
  });
  dialog.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    e.preventDefault();
    closeModal();
  });
  dialog.addEventListener('close', () => {
    document.documentElement.classList.remove('modal-open');
    delete dialog.dataset.closing;
  });

  // validation
  const messages: Record<string, (el: HTMLInputElement | HTMLTextAreaElement) => string> = {
    name: () => 'Please tell me your name.',
    email: (el) => (el.validity.valueMissing ? 'Please enter your email.' : 'That email doesn’t look right.'),
    message: (el) =>
      el.validity.valueMissing ? 'Write a short message.' : 'A little more detail, at least 10 characters.',
  };

  function validate(el: HTMLInputElement | HTMLTextAreaElement) {
    const field = el.closest('.field')!;
    const err = field.querySelector('.err') as HTMLElement;
    const ok = el.checkValidity() && el.value.trim() !== '';
    field.classList.toggle('invalid', !ok);
    el.setAttribute('aria-invalid', String(!ok));
    err.textContent = ok ? '' : messages[el.name](el);
    return ok;
  }

  const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')];
  fields.forEach((el) => {
    el.addEventListener('blur', () => el.value && validate(el));
    el.addEventListener('input', () => el.closest('.field')!.classList.contains('invalid') && validate(el));
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const results = fields.map(validate);
    if (results.includes(false)) {
      fields[results.indexOf(false)].focus();
      return;
    }

    const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
    const { name, email, message } = data;
    nameSlot.textContent = `, ${name.trim().split(/\s+/)[0]}`;

    // honeypot filled: a bot. Pretend success and send nothing.
    if (data.website) {
      doneText.textContent = 'Your message is on its way.';
      return setState('sent');
    }

    setState('sending');
    try {
      if (endpoint) {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ name, email, message }),
        });
        if (!res.ok) throw new Error(String(res.status));
        doneText.textContent = 'Your message is on its way. I’ll reply by email soon.';
      } else {
        const subject = encodeURIComponent(`Message from ${name}`);
        const body = encodeURIComponent(`${message}\n\n${name} (${email})`);
        window.location.href = `mailto:${toEmail}?subject=${subject}&body=${body}`;
        doneText.textContent = 'Your email app should be opening with the message ready. Just hit send.';
      }
      form.reset();
      setState('sent');
    } catch {
      setState('error');
    }
  });
</script>
