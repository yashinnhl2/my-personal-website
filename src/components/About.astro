---
import Icon from './Icon.astro';
import { education, profile } from '../data/profile';
---

<section id="about" class="card about reveal">
  <div class="intro">
    <span class="eyebrow">About</span>
    <h2>Software engineer,<br />shaped by <span>HCI</span><i>.</i></h2>
    <p class="summary">{profile.summary}</p>
    <p class="where"><Icon name="pin" size={16} /> {profile.location}</p>
  </div>

  <div class="study">
    <span class="cap"><Icon name="cap" size={26} /></span>
    <h3 class="card-title">I’ve studied, professionally.</h3>

    <ol>
      {education.map((e) => (
        <li>
          <span class="years">{e.years}</span>
          <h4>{e.degree}</h4>
          <p>{e.school}</p>
        </li>
      ))}
    </ol>

    <a class="scholar" href={profile.scholar} target="_blank" rel="noopener">
      <Icon name="book" size={18} />
      <span>Google Scholar</span>
      <Icon name="arrow" size={16} />
    </a>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }
  @media (min-width: 900px) {
    .about {
      grid-template-columns: 1.15fr 1fr;
      gap: 56px;
    }
  }

  /* left: summary */
  .intro {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  h2 {
    font-size: clamp(2rem, 4.2vw, 3.2rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.08;
  }
  h2 span {
    background: linear-gradient(90deg, var(--coral), var(--orange), var(--yellow));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  h2 i {
    font-style: normal;
    color: var(--teal);
  }
  .summary {
    max-width: 52ch;
    font-size: clamp(1.02rem, 1.6vw, 1.18rem);
    line-height: 1.7;
  }
  .where {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    font-size: 0.92rem;
    color: var(--text);
  }
  .where :global(svg) {
    color: var(--coral);
  }

  /* right: education */
  .study {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 26px;
    padding-left: 0;
  }
  @media (min-width: 900px) {
    .study {
      padding-left: 40px;
      border-left: 1px dashed rgba(255, 255, 255, 0.14);
    }
  }
  .cap {
    position: absolute;
    top: 0;
    right: 0;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    color: var(--yellow);
    background: #1f1f23;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 8px 20px rgba(0, 0, 0, 0.4);
    animation: float 4s ease-in-out infinite;
  }
  .card-title {
    max-width: 12ch;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0 0 0 18px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    border-left: 1px dashed rgba(255, 255, 255, 0.18);
  }
  li {
    position: relative;
  }
  li::before {
    content: '';
    position: absolute;
    left: -23px;
    top: 7px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--coral);
    box-shadow: 0 0 0 4px var(--card);
  }
  li:nth-child(2)::before {
    background: var(--teal);
  }
  .years {
    font-family: var(--font-dot);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--yellow);
  }
  h4 {
    margin: 2px 0 0;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text);
  }
  li p {
    font-size: 0.92rem;
  }

  .scholar {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
    background: #1d1d21;
    border: 1px solid var(--line);
    border-radius: var(--radius-btn);
    transition:
      background 0.3s,
      color 0.3s,
      border-color 0.3s,
      transform 0.4s var(--ease);
  }
  .scholar :global(svg:first-child) {
    color: var(--yellow);
    transition: color 0.3s;
  }
  .scholar :global(svg:last-child) {
    transition: transform 0.4s var(--ease);
  }
  .scholar:hover {
    color: #17110e;
    background: var(--yellow);
    border-color: var(--yellow);
    transform: translateY(-2px);
  }
  .scholar:hover :global(svg:first-child) {
    color: #17110e;
  }
  .scholar:hover :global(svg:last-child) {
    transform: translate(3px, -3px);
  }

  @keyframes float {
    50% {
      transform: translateY(-6px) rotate(-4deg);
    }
  }
</style>
